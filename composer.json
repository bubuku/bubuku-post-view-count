{
    "name": "bubuku/post-view-count",
    "description": "Bubuku Post View Count WordPress Plugin",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"wordpress",
		"plugin"
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"homepage": "https://github.com/bubuku/bubuku-post-view-count",
    "authors": [
        {
            "name": "Bubuku",
            "email": "icode@bubuku.com"
        }
    ],
	"autoload": {
		"psr-4": {
			"Bubuku\\Plugins\\PostViewCount\\": "src/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "php Tests/run.php"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
