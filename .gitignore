# Composer dev tooling (PHPCS/WPCS) — regenerate with `composer install`.
# Not needed at runtime; never required in the distributed package either.
/vendor/

# Node dependencies.
/node_modules/

# Compiled JS/CSS assets (npm run build) — built in CI, not committed.
/assets/build/

# Build output (scripts/build.sh).
/dist/

# OS / editor cruft.
.DS_Store
.vscode/
.idea/
