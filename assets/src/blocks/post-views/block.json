{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bubuku/post-views",
	"title": "Bubuku · Post Views",
	"category": "widgets",
	"icon": "chart-line",
	"description": "Displays the number of views recorded for the current post.",
	"textdomain": "bubuku-post-view-count",
	"attributes": {
		"showLastViewed": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
