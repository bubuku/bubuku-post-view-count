# Files and folders to exclude from the distributable zip

# AI & editor config
/.claude
/.codex
/.gemini
/.vscode

# Git & CI
/.git
/.github
.gitattributes
.gitignore

# WordPress.org assets (banners, screenshots — not part of the plugin itself)
/.wordpress-org

# Docs & project meta
/docs
/skills
.distignore
AGENTS.md
CHANGELOG.md
CLAUDE.md
GEMINI.md
README.md

# Dev dependencies
# vendor/ only holds dev tooling (PHPCS, WPCS). The plugin has no runtime
# Composer dependencies — see the spl_autoload_register() call in the main
# plugin file — so it's never needed in the distributed package.
/node_modules/
/vendor/
/dist/
/assets/src

# Package managers
composer.json
composer.lock
package.json
package-lock.json

# Build tools & config
webpack.config.js
.babelrc
.eslintrc
Gruntfile.js
Gulpfile.js
phpcs.xml
.phpcsrules.xml
phpunit.xml

# Tests
/tests/

# Build/dev scripts (not part of the runtime plugin)
/scripts/

# OS cruft
.DS_Store
Thumbs.db
